# ------------------------------------------------------------------------------
# 4. MULTI-THREADED ZERO-DEPENDENCY HTTP REQUEST HANDLER
# ------------------------------------------------------------------------------
class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True

class MineShieldHTTPHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def send_cors_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_cors_headers()
        self.end_headers()

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path

        if path in ["/", "/index.html"]:
            encoded = HTML_PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(encoded)))
            self.send_cors_headers()
            self.end_headers()
            self.wfile.write(encoded)
            return

        elif path == "/api/status":
            sensor_nodes = [n for n in state.nodes.values() if not n.get("isGateway")]
            res = {
                "status": "ONLINE",
                "system": "SMARTSURFACE-MESH",
                "problem_statement": "SIH26025",
                "gateway_id": "GW-01",
                "lease_location": "Korba Coalfield Seam 4 (22°41'12\" N, 82°35'44\" E)",
                "risk_level": state.risk_level,
                "max_tilt_deg": max((float(n.get("tilt", 0.0)) for n in sensor_nodes), default=0.0),
                "max_displacement_mm": max((float(n.get("disp", 0.0)) for n in sensor_nodes), default=0.0),
                "active_nodes_count": "8 / 8",
                "mesh_health": "87.5% (Self-Healed)" if state.active_node_failure else "99.4% (Optimal)"
            }
            self.send_json(res)
            return

        elif path == "/api/nodes":
            self.send_json(list(state.nodes.values()))
            return

        elif path == "/api/ai/predict":
            pred = compute_ai_prediction()
            self.send_json(pred)
            return

        elif path == "/api/logs":
            self.send_json({"logs": state.event_logs})
            return

        elif path == "/api/export/csv":
            csv_data = state.get_csv().encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/csv")
            self.send_header("Content-Disposition", "attachment; filename=mineshield_telemetry.csv")
            self.send_header("Content-Length", str(len(csv_data)))
            self.send_cors_headers()
            self.end_headers()
            self.wfile.write(csv_data)
            return

        else:
            self.send_error(404, "Endpoint not found")

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length).decode("utf-8") if length > 0 else "{}"
        try: payload = json.loads(body)
        except Exception: payload = {}

        if path == "/api/risk-level":
            level = payload.get("level", "NORMAL")
            state.set_risk(level)
            self.send_json({"status": "ok", "new_level": state.risk_level})
            return

        elif path == "/api/telemetry":
            node_id = payload.get("node_id")
            if not node_id:
                self.send_error(400, "Missing node_id")
                return
            updated = state.update_telemetry(node_id, payload)
            self.send_json({"status": "ok", "node": updated})
            return

        elif path == "/api/simulate/failover":
            res = state.toggle_failover()
            self.send_json(res)
            return

        elif path == "/api/alerts/broadcast":
            state.log(f"[BROADCAST DISPATCH] Multi-channel DGMS SMS, Email, and Push alerts transmitted for level {state.risk_level}.")
            self.send_json({"status": "DISPATCHED", "risk_level": state.risk_level})
            return

        else:
            self.send_error(404, "Endpoint not found")

    def send_json(self, data):
        encoded = json.dumps(data).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(encoded)))
        self.send_cors_headers()
        self.end_headers()
        self.wfile.write(encoded)

