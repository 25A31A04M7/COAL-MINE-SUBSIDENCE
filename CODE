# 5. BACKGROUND SENSOR JITTER SIMULATION THREAD
# ------------------------------------------------------------------------------
def background_sensor_simulation():
    while True:
        time.sleep(3.5)
        state.jitter()

# ------------------------------------------------------------------------------
# 6. MAIN EXECUTION ENTRY POINT
# ------------------------------------------------------------------------------
def run_server(port=8000):
    server_address = ("0.0.0.0", port)
    httpd = ThreadedHTTPServer(server_address, MineShieldHTTPHandler)

    sim_thread = threading.Thread(target=background_sensor_simulation, daemon=True)
    sim_thread.start()

    print("\n" + "=" * 70)
    print("  [*] MINESHIELD SMARTSURFACE-MESH: ALL-IN-ONE PYTHON SYSTEM")
    print("  SIH 2026 Problem Statement: SIH26025 | Team MineShield")
    print("=" * 70)
    print(f"  [DASHBOARD UI]    http://localhost:{port}")
    print(f"  [AI PREDICT API]  http://localhost:{port}/api/ai/predict")
    print(f"  [STATUS API]      http://localhost:{port}/api/status")
    print(f"  [NODES API]       http://localhost:{port}/api/nodes")
    print(f"  [CSV EXPORT]      http://localhost:{port}/api/export/csv")
    print("=" * 70)
    print("  Server is active. Press Ctrl+C in terminal to stop.")
    print("=" * 70 + "\n")

    try:
        webbrowser.open(f"http://localhost:{port}")
    except Exception:
        pass

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n[!] Server shutting down.")
        httpd.server_close()

if __name__ == "__main__":
    port_to_run = 8000
    if len(sys.argv) > 1:
        try: port_to_run = int(sys.argv[1])
        except ValueError: pass
    run_server(port_to_run)
