class MineShieldState:
    def __init__(self):
        self.lock = threading.Lock()
        self.nodes = {n["id"]: copy.deepcopy(n) for n in INITIAL_NODES}
        self.risk_level = "NORMAL"
        self.active_node_failure = False
        self.failed_node_id = None
        self.event_logs = [
            f"[{time.strftime('%H:%M:%S')}] Python All-In-One Gateway GW-01 online (8/8 LoRa nodes connected).",
            f"[{time.strftime('%H:%M:%S')}] Korba Coalfield Seam 4 Boundary Active: 22°41'12\" N, 82°35'44\" E."
        ]

    def log(self, msg: str):
        t = time.strftime("%H:%M:%S")
        self.event_logs.insert(0, f"[{t}] {msg}")
        if len(self.event_logs) > 150:
            self.event_logs.pop()

    def set_risk(self, level: str):
        with self.lock:
            level = level.upper()
            if level not in ["NORMAL", "WATCH", "HIGH", "CRITICAL"]:
                level = "NORMAL"
            self.risk_level = level

            for nid, n in self.nodes.items():
                if n.get("isGateway"): continue
                if level == "NORMAL":
                    n["tilt"] = round(random.uniform(0.12, 0.35), 2)
                    n["disp"] = round(random.uniform(0.20, 0.65), 2)
                    n["vib"] = round(random.uniform(0.01, 0.03), 2)
                    n["crack"] = 0.0
                    n["status"] = "NORMAL"
                elif level == "WATCH":
                    if n["zone"] == "Zone A":
                        n["tilt"] = round(random.uniform(2.10, 3.40), 2)
                        n["disp"] = round(random.uniform(3.20, 4.80), 2)
                        n["vib"] = round(random.uniform(0.12, 0.22), 2)
                        n["crack"] = 0.4
                        n["status"] = "WATCH"
                    else:
                        n["tilt"] = round(random.uniform(0.30, 0.70), 2)
                        n["disp"] = round(random.uniform(0.70, 1.20), 2)
                        n["status"] = "NORMAL"
                elif level == "HIGH":
                    if n["zone"] == "Zone A":
                        n["tilt"] = round(random.uniform(6.50, 8.80), 2)
                        n["disp"] = round(random.uniform(8.50, 11.50), 2)
                        n["vib"] = round(random.uniform(0.40, 0.65), 2)
                        n["crack"] = 1.8
                        n["status"] = "HIGH"
                    elif n["zone"] == "Zone B":
                        n["tilt"] = round(random.uniform(2.20, 3.10), 2)
                        n["disp"] = round(random.uniform(2.80, 3.90), 2)
                        n["status"] = "WATCH"
                    else:
                        n["tilt"] = round(random.uniform(0.60, 1.10), 2)
                        n["status"] = "NORMAL"
                elif level == "CRITICAL":
                    if n["zone"] == "Zone A":
                        n["tilt"] = round(random.uniform(13.80, 16.50), 2)
                        n["disp"] = round(random.uniform(22.00, 28.50), 2)
                        n["vib"] = round(random.uniform(1.20, 1.75), 2)
                        n["crack"] = 6.4
                        n["status"] = "CRITICAL"
                    else:
                        n["tilt"] = round(random.uniform(5.50, 7.80), 2)
                        n["disp"] = round(random.uniform(8.00, 12.00), 2)
                        n["vib"] = round(random.uniform(0.35, 0.50), 2)
                        n["crack"] = 1.5
                        n["status"] = "HIGH"

            self.log(f"Global Risk transitioned to {level}. Sensor models updated.")

    def update_telemetry(self, node_id: str, data: dict):
        with self.lock:
            if node_id not in self.nodes:
                self.nodes[node_id] = {"id": node_id, "name": f"Node {node_id}", "zone": data.get("zone", "Zone A"), "isGateway": False}
            n = self.nodes[node_id]
            if "tilt" in data: n["tilt"] = round(float(data["tilt"]), 2)
            if "disp" in data: n["disp"] = round(float(data["disp"]), 2)
            if "vib" in data: n["vib"] = round(float(data["vib"]), 2)
            if "crack" in data: n["crack"] = round(float(data["crack"]), 2)
            if "battery" in data: n["battery"] = int(data["battery"])
            if "rssi" in data: n["rssi"] = int(data["rssi"])
            if "status" in data: n["status"] = str(data["status"]).upper()
            self.log(f"Telemetry Rx from {node_id}: Tilt={n.get('tilt')}° Disp={n.get('disp')}mm")
            return copy.deepcopy(n)

    def toggle_failover(self, target="SN-02-A"):
        with self.lock:
            self.active_node_failure = not self.active_node_failure
            if self.active_node_failure:
                self.failed_node_id = target
                if target in self.nodes:
                    self.nodes[target]["status"] = "OFFLINE"
                self.log(f"[SELF-HEALING] Node {target} OFFLINE. Dynamic LoRa reroute: SN-01-A -> SN-04-B -> GW-01.")
                health = "87.5% (Self-Healed via Secondary Hop)"
            else:
                if self.failed_node_id in self.nodes:
                    self.nodes[self.failed_node_id]["status"] = "NORMAL"
                self.log(f"[RECOVERY] Node {self.failed_node_id} reconnected to mesh.")
                self.failed_node_id = None
                health = "99.4% (Optimal Multi-Hop)"
            return {"active_node_failure": self.active_node_failure, "failed_node_id": self.failed_node_id, "mesh_health": health}

    def jitter(self):
        with self.lock:
            if self.risk_level == "CRITICAL": return
            candidates = [nid for nid in self.nodes.keys() if nid != "GW-01" and nid != self.failed_node_id]
            if candidates:
                nid = random.choice(candidates)
                n = self.nodes[nid]
                n["tilt"] = max(0.05, round(n["tilt"] + random.uniform(-0.02, 0.02), 2))
                n["disp"] = max(0.10, round(n["disp"] + random.uniform(-0.03, 0.03), 2))

    def get_csv(self) -> str:
        with self.lock:
            out = io.StringIO()
            w = csv.writer(out)
            w.writerow(["Node_ID", "Zone", "Tilt_Deg", "Displacement_mm", "Vibration_g", "Crack_Gauge_mm", "Battery_Pct", "RSSI_dBm", "Status"])
            for n in self.nodes.values():
                w.writerow([n.get("id"), n.get("zone"), n.get("tilt", 0.0), n.get("disp", 0.0), n.get("vib", 0.0), n.get("crack", 0.0), n.get("battery", 100), n.get("rssi", -70), n.get("status", "NORMAL")])
            return out.getvalue()

