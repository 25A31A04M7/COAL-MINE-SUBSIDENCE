        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; font-size: 0.85rem;">
        <div style="background: #f8fafc; padding: 10px; border-radius: 6px;"><div style="color: var(--text-muted); font-size: 0.75rem;">Tilt Angle</div><strong id="modalTilt" style="color: #2563eb;">0.24°</strong></div>
        <div style="background: #f8fafc; padding: 10px; border-radius: 6px;"><div style="color: var(--text-muted); font-size: 0.75rem;">Displacement</div><strong id="modalDisplacement" style="color: #059669;">0.65 mm</strong></div>
        <div style="background: #f8fafc; padding: 10px; border-radius: 6px;"><div style="color: var(--text-muted); font-size: 0.75rem;">Vibration</div><strong id="modalVib" style="color: #d97706;">0.02 g</strong></div>
        <div style="background: #f8fafc; padding: 10px; border-radius: 6px;"><div style="color: var(--text-muted); font-size: 0.75rem;">Crack Gauge</div><strong id="modalCrack" style="color: #7c3aed;">0.00 mm</strong></div>
        <div style="background: #f8fafc; padding: 10px; border-radius: 6px;"><div style="color: var(--text-muted); font-size: 0.75rem;">Battery</div><strong id="modalBattery">98% (Solar Charging)</strong></div>
        <div style="background: #f8fafc; padding: 10px; border-radius: 6px;"><div style="color: var(--text-muted); font-size: 0.75rem;">LoRa Signal</div><strong id="modalRssi">-74 dBm</strong></div>
      </div>
      <div style="margin-top: 16px; text-align: right;"><button class="btn-action" onclick="closeNodeModal()">Close</button></div>
    </div>
  </div>

  <footer><strong>MineShield</strong> - Made in India Smart Mining Solution | SIH 2026 Problem Statement SIH26025</footer>

  <script>
    let currentRiskLevel = 'NORMAL';
    let meshLinesEnabled = true;
    let heatmapEnabled = false;
    let activeNodeFailure = false;
    let failedNodeId = null;

    let nodes = [
      { id: 'SN-01-A', name: 'Node 01 (Depillaring)', zone: 'Zone A', xRel: 0.28, yRel: 0.32, tilt: 0.24, disp: 0.5, vib: 0.02, crack: 0.0, battery: 98, rssi: -72, status: 'NORMAL' },
      { id: 'SN-02-A', name: 'Node 02 (Face 1)', zone: 'Zone A', xRel: 0.38, yRel: 0.42, tilt: 0.28, disp: 0.6, vib: 0.03, crack: 0.0, battery: 96, rssi: -75, status: 'NORMAL' },
      { id: 'GW-01',    name: 'Gateway GW-01', zone: 'Zone B', xRel: 0.50, yRel: 0.55, tilt: 0.00, disp: 0.0, vib: 0.00, crack: 0.0, battery: 100, rssi: -50, status: 'GATEWAY', isGateway: true },
      { id: 'SN-03-B', name: 'Node 03 (Central)', zone: 'Zone B', xRel: 0.50, yRel: 0.30, tilt: 0.15, disp: 0.3, vib: 0.01, crack: 0.0, battery: 94, rssi: -68, status: 'NORMAL' },
      { id: 'SN-04-B', name: 'Node 04 (North-East)', zone: 'Zone B', xRel: 0.62, yRel: 0.40, tilt: 0.18, disp: 0.4, vib: 0.01, crack: 0.0, battery: 97, rssi: -71, status: 'NORMAL' },
      { id: 'SN-05-C', name: 'Node 05 (South-West)', zone: 'Zone C', xRel: 0.33, yRel: 0.78, tilt: 0.12, disp: 0.2, vib: 0.01, crack: 0.0, battery: 92, rssi: -82, status: 'NORMAL' },
      { id: 'SN-06-C', name: 'Node 06 (West Panel)', zone: 'Zone C', xRel: 0.44, yRel: 0.85, tilt: 0.14, disp: 0.3, vib: 0.01, crack: 0.0, battery: 95, rssi: -78, status: 'NORMAL' },
      { id: 'SN-07-D', name: 'Node 07 (East Panel)', zone: 'Zone D', xRel: 0.58, yRel: 0.84, tilt: 0.10, disp: 0.2, vib: 0.01, crack: 0.0, battery: 99, rssi: -76, status: 'NORMAL' },
      { id: 'SN-08-D', name: 'Node 08 (South-East)', zone: 'Zone D', xRel: 0.68, yRel: 0.68, tilt: 0.11, disp: 0.2, vib: 0.01, crack: 0.0, battery: 91, rssi: -80, status: 'NORMAL' }
    ];

    const meshLinks = [
      ['SN-01-A', 'SN-02-A'], ['SN-02-A', 'GW-01'], ['SN-03-B', 'GW-01'], ['SN-04-B', 'GW-01'],
      ['SN-05-C', 'SN-06-C'], ['SN-06-C', 'GW-01'], ['SN-07-D', 'SN-08-D'], ['SN-08-D', 'GW-01'],
      ['SN-02-A', 'SN-04-B'], ['SN-06-C', 'SN-07-D']
    ];

    let signalPackets = meshLinks.map((_, i) => ({ linkIndex: i, progress: Math.random(), speed: 0.006 + Math.random() * 0.005 }));
    let chartTimeSeries, chartRadarFusion, chartRssi, chartBattery;
    let canvas, ctx, angleRadar = 0;

    document.addEventListener('DOMContentLoaded', () => {
      initMapCanvas();
      renderNodeListMini();
      initCharts();
      renderSpatiotemporalGrid();
      renderMeshDiagram();
      syncWithPythonBackend();
      setInterval(syncWithPythonBackend, 3500);
    });

    function switchTab(tabId, btn) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      btn.classList.add('active');
      if (tabId === 'gisMap') setTimeout(resizeCanvas, 100);
    }

    function setRiskLevel(level) {
      currentRiskLevel = level;
      document.querySelectorAll('.btn-level').forEach(btn => btn.classList.remove('active'));
      document.getElementById('btn' + level.charAt(0).toUpperCase() + level.slice(1).toLowerCase()).classList.add('active');
      
      fetch('/api/risk-level', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ level: level })
      }).then(() => syncWithPythonBackend()).catch(() => {});

      if (level === 'CRITICAL') triggerSirenAlert();
      else stopSirenAlert();
    }

    function syncWithPythonBackend() {
      fetch('/api/nodes').then(r => r.json()).then(data => {
        nodes = data;
        updateUIOverall();
      }).catch(() => {});

      fetch('/api/logs').then(r => r.json()).then(data => {
        const term = document.getElementById('logTerminal');
        if (term && data.logs) term.innerHTML = data.logs.join('<br>');
      }).catch(() => {});
    }

    function onTiltSliderChange(val) {
      document.getElementById('lblTiltSlider').innerText = val + '°';
      const f = parseFloat(val);
      if (f < 1.0) setRiskLevel('NORMAL');
      else if (f < 4.0) setRiskLevel('WATCH');
      else if (f < 10.0) setRiskLevel('HIGH');
      else setRiskLevel('CRITICAL');
    }

    function updateUIOverall() {
      let maxTilt = 0, maxDisp = 0;
      nodes.forEach(n => {
        if (!n.isGateway) {
          if (parseFloat(n.tilt) > maxTilt) maxTilt = parseFloat(n.tilt);
          if (parseFloat(n.disp) > maxDisp) maxDisp = parseFloat(n.disp);
        }
      });

      document.getElementById('valMaxTilt').innerText = maxTilt.toFixed(2) + '°';
      document.getElementById('valDisplacement').innerText = maxDisp.toFixed(2) + ' mm';
      let riskScore = Math.min(100, Math.round((maxTilt / 15.0) * 100));
      document.getElementById('valRiskScore').innerText = riskScore + '%';

      const catEl = document.getElementById('valRiskCategory');
      const catIcon = document.getElementById('iconRiskBg');
      if (currentRiskLevel === 'NORMAL') {
        catEl.innerText = 'LOW RISK - SAFE GROUND'; catEl.style.color = '#059669'; catIcon.className = 'stat-icon icon-green';
      } else if (currentRiskLevel === 'WATCH') {
        catEl.innerText = 'MODERATE RISK - WATCH ZONE A'; catEl.style.color = '#d97706'; catIcon.className = 'stat-icon icon-orange';
      } else if (currentRiskLevel === 'HIGH') {
        catEl.innerText = 'HIGH RISK - DEPRESSION SPREADING'; catEl.style.color = '#ea580c'; catIcon.className = 'stat-icon icon-orange';
      } else {
        catEl.innerText = 'CRITICAL RISK - SUBSIDENCE IMMINENT!'; catEl.style.color = '#dc2626'; catIcon.className = 'stat-icon icon-purple';
      }

      document.getElementById('aiVelVal').innerText = (maxTilt * 0.45).toFixed(2) + ' mm/hour';
      const ttfEl = document.getElementById('aiTtfVal');
      const dgmsEl = document.getElementById('aiDgmsVal');
      if (currentRiskLevel === 'NORMAL') {
        ttfEl.innerText = '> 72 Hours (STABLE BASELINE)'; ttfEl.style.color = '#059669';
        dgmsEl.innerText = 'COMPLIANT (SAFE)'; dgmsEl.style.color = '#047857';
      } else if (currentRiskLevel === 'WATCH') {
        ttfEl.innerText = '~ 24-48 Hours (SLOW TILT)'; ttfEl.style.color = '#d97706';
        dgmsEl.innerText = 'WARNING: DGMS LEVEL 2 TRIGGERED'; dgmsEl.style.color = '#b45309';
      } else if (currentRiskLevel === 'HIGH') {
        ttfEl.innerText = '~ 4-8 Hours (RAPID MOVEMENTS)'; ttfEl.style.color = '#ea580c';
        dgmsEl.innerText = 'ACTION: STOP FACE MACHINERY'; dgmsEl.style.color = '#c2410c';
      } else {
        ttfEl.innerText = 'IMMINENT (< 30 MINUTES)'; ttfEl.style.color = '#dc2626';
        dgmsEl.innerText = 'EMERGENCY EVACUATION MANDATED'; dgmsEl.style.color = '#b91c1c';
      }

      renderNodeListMini();
      updateChartsData(maxTilt, maxDisp);
      renderSpatiotemporalGrid();
    }

    function initMapCanvas() {
      canvas = document.getElementById('meshCanvas');
      ctx = canvas.getContext('2d');
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);
      canvas.addEventListener('click', handleCanvasClick);
      requestAnimationFrame(drawMapFrame);
    }

    function resizeCanvas() {
      const container = document.getElementById('mapContainer');
      if (!container || !canvas) return;
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;
    }

    function drawMapFrame() {
      if (!canvas || !ctx) return;
      const w = canvas.width, h = canvas.height;
      ctx.fillStyle = '#090d16';
      ctx.fillRect(0, 0, w, h);

      // Grid
      ctx.strokeStyle = '#1e293b'; ctx.lineWidth = 1;
      for (let x = 0; x < w; x += 40) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); }
      for (let y = 0; y < h; y += 40) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke(); }

      // Radar Concentric Circles
      const cx = w * 0.5, cy = h * 0.55;
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.15)';
      [80, 160, 240, 320].forEach(r => { ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.stroke(); });

      // Radar beam
      angleRadar += 0.015;
      ctx.save();
      ctx.translate(cx, cy); ctx.rotate(angleRadar);
      const grad = ctx.createRadialGradient(0, 0, 10, 0, 0, 240);
      grad.addColorStop(0, 'rgba(56, 189, 248, 0.25)'); grad.addColorStop(1, 'rgba(56, 189, 248, 0)');
      ctx.fillStyle = grad; ctx.beginPath(); ctx.moveTo(0, 0); ctx.arc(0, 0, 240, 0, Math.PI * 0.25); ctx.closePath(); ctx.fill();
      ctx.restore();

      // Zone Boxes
      ctx.strokeStyle = (currentRiskLevel === 'CRITICAL' || currentRiskLevel === 'HIGH') ? 'rgba(239, 68, 68, 0.8)' : 'rgba(245, 158, 11, 0.6)';
      ctx.strokeRect(w * 0.22, h * 0.18, w * 0.22, h * 0.35);
      ctx.fillStyle = '#ef4444'; ctx.font = 'bold 10px monospace';
      ctx.fillText('[Zone A] ACTIVE DEPILARING FACE', w * 0.23, h * 0.22);

      ctx.strokeStyle = 'rgba(56, 189, 248, 0.7)';
      ctx.strokeRect(w * 0.46, h * 0.18, w * 0.25, h * 0.42);
      ctx.fillStyle = '#38bdf8';
      ctx.fillText('[Zone B] CENTRAL STABILITY', w * 0.48, h * 0.22);

      // Heatmap
      if (heatmapEnabled || currentRiskLevel === 'HIGH' || currentRiskLevel === 'CRITICAL') {
        const hx = w * 0.33, hy = h * 0.37;
        const hr = (currentRiskLevel === 'CRITICAL') ? 140 : 80;
        const hg = ctx.createRadialGradient(hx, hy, 5, hx, hy, hr);
        hg.addColorStop(0, currentRiskLevel === 'CRITICAL' ? 'rgba(239,68,68,0.75)' : 'rgba(245,158,11,0.6)');
        hg.addColorStop(1, 'rgba(239,68,68,0)');
        ctx.fillStyle = hg; ctx.beginPath(); ctx.arc(hx, hy, hr, 0, Math.PI*2); ctx.fill();
      }

      // Mesh Links
      if (meshLinesEnabled) {
        meshLinks.forEach((link, idx) => {
          const a = nodes.find(n => n.id === link[0]), b = nodes.find(n => n.id === link[1]);
          if (!a || !b) return;
          if (activeNodeFailure && (a.id === failedNodeId || b.id === failedNodeId)) return;

          const ax = a.xRel * w, ay = a.yRel * h, bx = b.xRel * w, by = b.yRel * h;
          ctx.beginPath(); ctx.moveTo(ax, ay); ctx.lineTo(bx, by);
          ctx.setLineDash([4, 4]); ctx.strokeStyle = currentRiskLevel === 'CRITICAL' ? 'rgba(239, 68, 68, 0.6)' : 'rgba(56, 189, 248, 0.45)';
          ctx.lineWidth = 1.5; ctx.stroke(); ctx.setLineDash([]);

          const pkt = signalPackets[idx];
          if (pkt) {
            pkt.progress += pkt.speed; if (pkt.progress > 1) pkt.progress = 0;
            const px = ax + (bx - ax) * pkt.progress, py = ay + (by - ay) * pkt.progress;
            ctx.fillStyle = currentRiskLevel === 'CRITICAL' ? '#ef4444' : '#38bdf8';
            ctx.beginPath(); ctx.arc(px, py, 3.5, 0, Math.PI*2); ctx.fill();
          }
        });
      }

      // Nodes
      nodes.forEach(n => {
        const nx = n.xRel * w, ny = n.yRel * h;
        if (activeNodeFailure && n.id === failedNodeId) {
          ctx.fillStyle = '#64748b'; ctx.beginPath(); ctx.arc(nx, ny, 7, 0, Math.PI*2); ctx.fill();
          ctx.fillStyle = '#ef4444'; ctx.font = 'bold 9px monospace'; ctx.fillText(n.id + ' [OFFLINE]', nx + 10, ny + 3);
          return;
        }

        let nodeColor = n.isGateway ? '#2563eb' : (n.status === 'CRITICAL' ? '#ef4444' : (n.status === 'HIGH' ? '#f97316' : (n.status === 'WATCH' ? '#f59e0b' : '#10b981')));
        ctx.fillStyle = nodeColor; ctx.beginPath(); ctx.arc(nx, ny, n.isGateway ? 10 : 7, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 2; ctx.stroke();
        ctx.fillStyle = '#ffffff'; ctx.font = 'bold 10px monospace'; ctx.fillText(n.id, nx + 10, ny + 3);
        if (!n.isGateway) { ctx.fillStyle = '#94a3b8'; ctx.font = '9px monospace'; ctx.fillText(`${n.tilt}° | ${n.disp}mm`, nx + 10, ny + 14); }
      });

      requestAnimationFrame(drawMapFrame);
    }

    function handleCanvasClick(e) {
      const rect = canvas.getBoundingClientRect();
      const clickX = e.clientX - rect.left, clickY = e.clientY - rect.top;
      const w = canvas.width, h = canvas.height;
      nodes.forEach(n => {
        const dist = Math.sqrt((clickX - n.xRel * w) ** 2 + (clickY - n.yRel * h) ** 2);
        if (dist <= 16) openNodeModal(n);
      });
    }

    function renderNodeListMini() {
      const el = document.getElementById('nodeListMini');
      if (!el) return;
      el.innerHTML = '';
      nodes.forEach(n => {
        const d = document.createElement('div');
        d.className = 'node-item';
        d.onclick = () => openNodeModal(n);
        d.innerHTML = `<div><span class="node-tag">${n.id}</span><div class="node-zone">${n.zone}</div></div><div class="node-metrics"><div>Tilt: <strong>${n.tilt}°</strong></div><span class="status-badge badge-${n.status.toLowerCase()}">${n.status}</span></div>`;
        el.appendChild(d);
      });
    }

    function openNodeModal(n) {
      document.getElementById('modalNodeId').innerText = n.id + (n.isGateway ? ' (GATEWAY)' : '');
      document.getElementById('modalNodeZone').innerText = n.zone;
      document.getElementById('modalTilt').innerText = `${n.tilt}°`;
      document.getElementById('modalDisplacement').innerText = `${n.disp} mm`;
      document.getElementById('modalVib').innerText = `${n.vib} g`;
      document.getElementById('modalCrack').innerText = `${n.crack} mm`;
      document.getElementById('modalBattery').innerText = `${n.battery}% (LiFePO4 Solar)`;
      document.getElementById('modalRssi').innerText = `${n.rssi} dBm`;
      document.getElementById('nodeModal').classList.add('active');
    }
    function closeNodeModal() { document.getElementById('nodeModal').classList.remove('active'); }

    function initCharts() {
      const ctxTime = document.getElementById('chartTimeSeries').getContext('2d');
      chartTimeSeries = new Chart(ctxTime, {
        type: 'line',
        data: {
          labels: ['00s', '10s', '20s', '30s', '40s', '50s', '60s'],
          datasets: [
            { label: 'Ground Tilt (°)', data: [0.2, 0.22, 0.25, 0.24, 0.28, 0.3, 0.32], borderColor: '#2563eb', tension: 0.3 },
            { label: 'Displacement (mm)', data: [0.4, 0.45, 0.5, 0.52, 0.6, 0.7, 0.85], borderColor: '#059669', tension: 0.3 }
          ]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });

      const ctxRadar = document.getElementById('chartRadarFusion').getContext('2d');
      chartRadarFusion = new Chart(ctxRadar, {
        type: 'radar',
        data: {
          labels: ['IMU Tilt', 'Displacement', 'Micro Vibration', 'Crack Meter', 'Temp Anomaly'],
          datasets: [{ label: 'Sensor Signature', data: [15, 12, 10, 5, 8], backgroundColor: 'rgba(37, 99, 235, 0.25)', borderColor: '#2563eb' }]
        },
        options: { responsive: true, maintainAspectRatio: false, scales: { r: { min: 0, max: 100 } } }
      });

      const ctxRssi = document.getElementById('chartRssi').getContext('2d');
      chartRssi = new Chart(ctxRssi, {
        type: 'bar',
        data: { labels: nodes.filter(n => !n.isGateway).map(n => n.id), datasets: [{ label: 'LoRa RSSI (dBm)', data: nodes.filter(n => !n.isGateway).map(n => n.rssi), backgroundColor: '#38bdf8' }] },
        options: { responsive: true, maintainAspectRatio: false }
      });

      const ctxBat = document.getElementById('chartBattery').getContext('2d');
      chartBattery = new Chart(ctxBat, {
        type: 'bar',
        data: { labels: nodes.filter(n => !n.isGateway).map(n => n.id), datasets: [{ label: 'Battery %', data: nodes.filter(n => !n.isGateway).map(n => n.battery), backgroundColor: '#10b981' }] },
        options: { responsive: true, maintainAspectRatio: false }
      });
    }

    function updateChartsData(maxTilt, maxDisp) {
      if (!chartTimeSeries) return;
      const now = new Date().toLocaleTimeString().slice(3, 8);
      chartTimeSeries.data.labels.shift(); chartTimeSeries.data.labels.push(now);
      chartTimeSeries.data.datasets[0].data.shift(); chartTimeSeries.data.datasets[0].data.push(maxTilt);
      chartTimeSeries.data.datasets[1].data.shift(); chartTimeSeries.data.datasets[1].data.push(maxDisp);
      chartTimeSeries.update();

      let val = currentRiskLevel === 'CRITICAL' ? 95 : (currentRiskLevel === 'HIGH' ? 75 : (currentRiskLevel === 'WATCH' ? 40 : 15));
      chartRadarFusion.data.datasets[0].data = [val, val * 0.9, val * 0.8, val * 0.7, val * 0.4];
      chartRadarFusion.update();
    }

    function renderSpatiotemporalGrid() {
      const g = document.getElementById('spatiotemporalGrid');
      if (!g) return;
      g.innerHTML = '';
      nodes.filter(n => !n.isGateway).forEach(n => {
        const d = document.createElement('div');
        d.className = 'grid-cell';
        d.style.background = n.status === 'CRITICAL' ? '#fee2e2' : (n.status === 'HIGH' ? '#ffedd5' : (n.status === 'WATCH' ? '#fef3c7' : '#f8fafc'));
        d.innerHTML = `<div>${n.id}</div><div class="cell-val" style="color: ${n.status === 'NORMAL' ? '#059669' : '#dc2626'}">${n.tilt}°</div>`;
        g.appendChild(d);
      });
    }

    function renderMeshDiagram() {
      const c = document.getElementById('meshDiagramContainer');
      if (!c) return;
      c.innerHTML = '';
      nodes.filter(n => !n.isGateway).forEach(n => {
        const d = document.createElement('div');
        d.style.cssText = 'background:#1e293b; padding:10px 14px; border-radius:8px; text-align:center; border:1px solid #334155;';
        d.innerHTML = `<div style="font-weight:bold; color:#38bdf8;">${n.id}</div><div style="font-size:0.75rem; color:#94a3b8;">${n.zone}</div><div style="font-size:0.72rem; color:#10b981; margin-top:4px;"><i class="fa-solid fa-arrow-right"></i> ${n.zone === 'Zone A' ? '2 Hops' : '1 Hop'} -> GW-01</div>`;
        c.appendChild(d);
      });
    }

    function toggleMeshLines() {
      meshLinesEnabled = !meshLinesEnabled;
      document.getElementById('btnToggleMesh').innerText = `Mesh Links: ${meshLinesEnabled ? 'ON' : 'OFF'}`;
      document.getElementById('btnToggleMesh').classList.toggle('active', meshLinesEnabled);
    }

    function toggleHeatmap() {
      heatmapEnabled = !heatmapEnabled;
      document.getElementById('btnToggleHeatmap').innerText = `Heatmap: ${heatmapEnabled ? 'ON' : 'OFF'}`;
      document.getElementById('btnToggleHeatmap').classList.toggle('active', heatmapEnabled);
    }

    function simulateNodeFailure() {
      fetch('/api/simulate/failover', { method: 'POST' }).then(r => r.json()).then(res => {
        activeNodeFailure = res.active_node_failure;
        failedNodeId = res.failed_node_id;
        document.getElementById('valMeshHealth').innerText = `Mesh Health: ${res.mesh_health}`;
        alert(activeNodeFailure ? 'Simulated Failure: Node SN-02-A offline!\\nMesh auto-rerouted via Node SN-04-B.' : 'Node SN-02-A reconnected!');
        syncWithPythonBackend();
      });
    }

    let sirenCtx = null, sirenOsc = null, sirenTimer = null;
    function triggerSirenAlert() {
      stopSirenAlert();
      const b = document.getElementById('alarmBanner'); if (b) b.classList.add('active');
      try {
        sirenCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (sirenCtx.state === 'suspended') sirenCtx.resume();
        sirenOsc = sirenCtx.createOscillator();
        const gain = sirenCtx.createGain();
        sirenOsc.type = 'sawtooth';
        sirenOsc.frequency.setValueAtTime(650, sirenCtx.currentTime);
        let hi = false;
        sirenTimer = setInterval(() => {
          if (!sirenOsc || !sirenCtx) return;
          sirenOsc.frequency.linearRampToValueAtTime(hi ? 650 : 950, sirenCtx.currentTime + 0.35);
          hi = !hi;
        }, 380);
        gain.gain.setValueAtTime(0.25, sirenCtx.currentTime);
        sirenOsc.connect(gain); gain.connect(sirenCtx.destination);
        sirenOsc.start();
      } catch(e) {}
    }
    function stopSirenAlert() {
      if (sirenTimer) { clearInterval(sirenTimer); sirenTimer = null; }
      if (sirenOsc) { try { sirenOsc.stop(); sirenOsc.disconnect(); } catch(e){} sirenOsc = null; }
      if (sirenCtx) { try { sirenCtx.close(); } catch(e){} sirenCtx = null; }
      const b = document.getElementById('alarmBanner'); if (b) b.classList.remove('active');
    }
    document.addEventListener('click', () => { if (sirenCtx && sirenCtx.state === 'suspended') sirenCtx.resume(); });

    function dispatchTestAlert() {
      fetch('/api/alerts/broadcast', {
        method: 'POST',
